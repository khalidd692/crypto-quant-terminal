{
  "name": "crypto-quant-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "terminal": "node dist/src/cli.js",
    "research": "npm run build && node dist/src/research/cli.js",
    "server": "node dist/src/server.js",
    "test": "rm -rf dist && npm run build && bash scripts/run-tests.sh",
    "test:runner-self-test": "bash scripts/test-runner-self-test.sh",
    "holdout": "npm run build && node dist/src/holdout/cli.js",
    "automation": "npm run build && node dist/src/automation/runner.js"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
